# ---------------------------------------------------------------------------
# Carrier selection
# ---------------------------------------------------------------------------
# "fake" is the built-in offline carrier: deterministic prices, no network, no
# account. "ups" talks to the real UPS Rating API and needs the block below.
CARRIER_ID=fake

# ---------------------------------------------------------------------------
# HTTP facade
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=7121

# ---------------------------------------------------------------------------
# Outbound call behaviour (applies to whichever carrier is selected)
# ---------------------------------------------------------------------------
# Abort an outbound carrier request after this many ms.
REQUEST_TIMEOUT_MS=30000
# Total attempts including the first. Only 429 and 5xx responses are retried.
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=5000

# ---------------------------------------------------------------------------
# UPS credentials — required only when CARRIER_ID=ups
# ---------------------------------------------------------------------------
# UPS REST base (no trailing slash). CIE example:
# https://wwwcie.ups.com/api
# Production: https://onlinetools.ups.com/api
UPS_API_BASE_URL=https://wwwcie.ups.com/api

# OAuth client-credentials token URL (full URL). CIE example:
# https://wwwcie.ups.com/security/v1/oauth/token
UPS_OAUTH_TOKEN_URL=https://wwwcie.ups.com/security/v1/oauth/token

UPS_CLIENT_ID=your_client_id
UPS_CLIENT_SECRET=your_client_secret

# Billed account. Leave blank to request published rates with no BillShipper block.
UPS_ACCOUNT_NUMBER=

# Rating API path version segment (see the UPS Rating OpenAPI document).
UPS_RATING_VERSION=v2409

# Refresh the access token this many ms before OAuth's expires_in elapses.
TOKEN_SKEW_MS=60000
