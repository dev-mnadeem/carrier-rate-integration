{
  "name": "cybership-carrier-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "npm run build && node dist/server/start.js",
    "verify": "npm run lint && npm run typecheck && npm test",
    "serve": "node dist/server/start.js"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.9"
  },
  "description": "Carrier rate-shopping integration: a typed RatingCarrier port, a UPS Rating adapter, an offline fake, and a thin HTTP facade.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
